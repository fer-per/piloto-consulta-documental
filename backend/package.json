{
  "name": "siarc-ara-backend",
  "version": "1.0.0",
  "description": "API REST del SIARC-ARA: autenticación y consulta documental del Archivo Regional de Arequipa",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:reset": "node scripts/init-db.mjs",
    "db:schema": "node scripts/init-db.mjs --solo-esquema",
    "db:seed": "node scripts/init-db.mjs --solo-seed"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1"
  }
}
