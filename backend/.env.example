# Entorno de ejecución del API SIARC-ARA
NODE_ENV=development
PORT=4000

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=siarc_db
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Autenticación (JWT). Obligatorio: mínimo 16 caracteres.
JWT_SECRET=cambie-esta-clave-secreta-siarc-ara-2026
JWT_EXPIRA_EN=8h

# Control de acceso por intentos fallidos (HU-17)
BLOQUEO_INTENTOS=5
BLOQUEO_MINUTOS=15

# Repositorio digital (archivos TIFF/PDF-A y miniaturas)
RUTA_REPOSITORIO=../storage/repositorio

# Almacenamiento del repositorio: local (disco) o r2 (Cloudflare R2)
ALMACENAMIENTO=local
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Prefijo opcional dentro del bucket (por ejemplo: repositorio)
R2_PREFIX=repositorio

# Compilación del frontend que el API sirve en producción
RUTA_FRONTEND=../frontend/dist

# Origen permitido del frontend (en producción use su dominio)
CORS_ORIGIN=http://localhost:5173
